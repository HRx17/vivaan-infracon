# Password for /admin. Required in production.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign the admin session cookie (any long random string).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Optional – on Vercel, connect a Blob store and this is set for you.
# When present, projects, enquiries and photos are stored in Vercel Blob.
# When absent, they are stored on disk in ./data (fine for local / a VPS).
BLOB_READ_WRITE_TOKEN=

# Optional – email notification for each new enquiry via Resend (resend.com).
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Vivaan Infracon <hello@yourdomain.com>"
RESEND_FROM=

# Public site URL, used for metadata / share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
